{
  "Comment": "LookSee pipeline skeleton: mark started -> branch -> placeholders -> ready for label",
  "StartAt": "InitialJitter",
  "States": {
    "InitialJitter": {
      "Type": "Wait",
      "Seconds": 2,
      "Next": "MarkPipelineStarted"
    },
    "MarkPipelineStarted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "LookSeePipelineUpdateStatus",
        "Payload": {
          "submissionId.$": "$.submissionId",
          "status": "PIPELINE_STARTED"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "BranchOnMediaKind",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 6
        }
      ]
    },
    "BranchOnMediaKind": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.mediaKind",
          "StringEquals": "video",
          "Next": "VideoPlaceholder"
        }
      ],
      "Default": "ImagePlaceholder"
    },
    "VideoPlaceholder": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "LookSeePipelineUpdateStatus",
        "Payload": {
          "submissionId.$": "$.submissionId",
          "status": "FRAMES_PENDING",
          "statusReason": "Placeholder: frame extraction not implemented yet"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "ReadyForLabel",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 8
        }
      ]
    },
    "ImagePlaceholder": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "LookSeePipelineUpdateStatus",
        "Payload": {
          "submissionId.$": "$.submissionId",
          "status": "READY_FOR_LABEL"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "Done",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 8
        }
      ]
    },
    "ReadyForLabel": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "LookSeePipelineUpdateStatus",
        "Payload": {
          "submissionId.$": "$.submissionId",
          "status": "READY_FOR_LABEL"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "Done",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 8
        }
      ]
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}