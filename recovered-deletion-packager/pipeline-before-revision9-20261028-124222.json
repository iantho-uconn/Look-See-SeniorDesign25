{
  "Comment": "LookSee clustered training pipeline negtest - hard negatives sandbox",
  "StartAt": "PrepareRun",
  "States": {
    "PrepareRun": {
      "Type": "Pass",
      "Parameters": {
        "trainingRunId.$": "States.UUID()",
        "bucket.$": "$.bucket",
        "datasetPrefix.$": "$.datasetPrefix",
        "onlyDirty.$": "$.onlyDirty",
        "clearDest.$": "$.clearDest"
      },
      "Next": "SnapshotClusterMappings"
    },
    "SnapshotClusterMappings": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:637404140724:function:LookSee-Snapshot-Cluster-Mappings",
        "Payload": {
          "trainingRunId.$": "$.trainingRunId",
          "mappingVersion.$": "$.trainingRunId"
        }
      },
      "ResultSelector": {
        "mappingVersion.$": "$.Payload.mappingVersion",
        "sourceRevision.$": "$.Payload.sourceRevision",
        "mappingCount.$": "$.Payload.mappingCount",
        "status.$": "$.Payload.status",
        "dirtyMappingCount.$": "$.Payload.dirtyMappingCount"
      },
      "ResultPath": "$.mappingSnapshot",
      "Next": "RunDatasetPackager"
    },
    "RunDatasetPackager": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "arn:aws:ecs:us-east-1:637404140724:cluster/LookSee-Cluster",
        "TaskDefinition": "arn:aws:ecs:us-east-1:637404140724:task-definition/Looksee-dataset-packager-hard-negatives:8",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": [
              "subnet-06b870d7eb82a89b4"
            ],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "dataset-packager-HN",
              "Environment": [
                {
                  "Name": "TRAINING_RUN_ID",
                  "Value.$": "$.trainingRunId"
                },
                {
                  "Name": "BUCKET",
                  "Value.$": "$.bucket"
                },
                {
                  "Name": "SRC_PREFIX",
                  "Value": "neg-dataset/"
                },
                {
                  "Name": "DEST_PREFIX",
                  "Value.$": "$.datasetPrefix"
                },
                {
                  "Name": "TRAIN_SPLIT",
                  "Value": "0.8"
                },
                {
                  "Name": "CLEAR_DEST",
                  "Value.$": "States.Format('{}', $.clearDest)"
                },
                {
                  "Name": "LANDMARKS_TABLE",
                  "Value": "LookSeeLandmarks"
                },
                {
                  "Name": "PUBLISHED_CLUSTER_MAPPINGS_TABLE",
                  "Value": "LookSeePublishedClusterMappings"
                },
                {
                  "Name": "MAPPING_VERSION",
                  "Value.$": "$.mappingSnapshot.mappingVersion"
                },
                {
                  "Name": "SOURCE_MAPPING_REVISION",
                  "Value.$": "$.mappingSnapshot.sourceRevision"
                },
                {
                  "Name": "INCLUDE_NEGATIVES",
                  "Value": "true"
                },
                {
                  "Name": "GLOBAL_NEG_PREFIX",
                  "Value": "neg-dataset/negatives/global/"
                },
                {
                  "Name": "NEG_PREFIX",
                  "Value": "neg-dataset/negatives/"
                },
                {
                  "Name": "NEG_RATIO",
                  "Value": "1.0"
                },
                {
                  "Name": "NEG_MAX",
                  "Value": "400"
                },
                {
                  "Name": "ALLOW_LEGACY_NEGATIVE_FALLBACK",
                  "Value": "true"
                },
                {
                  "Name": "INCLUDE_HARD_NEGATIVES",
                  "Value": "true"
                },
                {
                  "Name": "HARD_NEG_ROOT",
                  "Value": "neg-dataset/negatives/by-landmark/"
                },
                {
                  "Name": "HARD_NEG_RATIO",
                  "Value": "0.25"
                },
                {
                  "Name": "HARD_NEG_MAX_PER_LANDMARK",
                  "Value": "500"
                },
                {
                  "Name": "BALANCE_STRATEGY",
                  "Value": "none"
                },
                {
                  "Name": "MAX_IMAGES_PER_CLASS",
                  "Value": "2200"
                },
                {
                  "Name": "MIN_IMAGES_PER_CLASS",
                  "Value": "2000"
                },
                {
                  "Name": "ONLY_DIRTY",
                  "Value.$": "States.Format('{}', $.onlyDirty)"
                }
              ]
            }
          ]
        }
      },
      "ResultPath": "$.packagerResult",
      "Next": "PackagerSucceeded"
    },
    "ReadManifest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:637404140724:function:LookSee-read-training-manifest",
        "Payload": {
          "bucket.$": "$.bucket",
          "trainingRunId.$": "$.trainingRunId",
          "datasetPrefix.$": "$.datasetPrefix"
        }
      },
      "ResultPath": "$.manifestRead",
      "Next": "HasTrainableClusters"
    },
    "HasTrainableClusters": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.manifestRead.Payload.clusterCount",
          "NumericGreaterThan": 0,
          "Next": "TrainClusters"
        }
      ],
      "Default": "NoTrainableClusters"
    },
    "NoTrainableClusters": {
      "Type": "Succeed"
    },
    "TrainClusters": {
      "Type": "Map",
      "ItemsPath": "$.manifestRead.Payload.includedClusters",
      "MaxConcurrency": 10,
      "ItemSelector": {
        "trainingRunId.$": "$.trainingRunId",
        "bucket.$": "$.bucket",
        "clusterId.$": "$$.Map.Item.Value.clusterId",
        "datasetPrefix.$": "$$.Map.Item.Value.datasetPrefix",
        "classNames.$": "$$.Map.Item.Value.classNames",
        "imageCount.$": "$$.Map.Item.Value.imageCount",
        "positiveImageCount.$": "$$.Map.Item.Value.positiveImageCount",
        "globalNegativeCount.$": "$$.Map.Item.Value.globalNegativeCount",
        "hardNegativeCount.$": "$$.Map.Item.Value.hardNegativeCount",
        "totalImageCount.$": "$$.Map.Item.Value.totalImageCount",
        "mappingVersion.$": "$.mappingSnapshot.mappingVersion",
        "sourceMappingRevision.$": "$.mappingSnapshot.sourceRevision"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "LaunchSageMakerTrainingJob",
        "States": {
          "LaunchSageMakerTrainingJob": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sagemaker:createTrainingJob.sync",
            "Parameters": {
              "TrainingJobName.$": "States.Format('ls-{}-c{}', $.trainingRunId, $.clusterId)",
              "AlgorithmSpecification": {
                "TrainingImage": "637404140724.dkr.ecr.us-east-1.amazonaws.com/looksee-sagemaker-training@sha256:e6781aa8fd564d29ea30edae7d9dd5396bee11b005cf21ccbc9baf951b6dcfd0",
                "TrainingInputMode": "File"
              },
              "RoleArn": "arn:aws:iam::637404140724:role/LookSeeSageMakerTrainingRole",
              "InputDataConfig": [
                {
                  "ChannelName": "training",
                  "DataSource": {
                    "S3DataSource": {
                      "S3DataType": "S3Prefix",
                      "S3Uri.$": "States.Format('s3://{}/{}', $.bucket, $.datasetPrefix)",
                      "S3DataDistributionType": "FullyReplicated"
                    }
                  }
                }
              ],
              "OutputDataConfig": {
                "S3OutputPath.$": "States.Format('s3://{}/sagemaker-training-output-negtest/', $.bucket)"
              },
              "ResourceConfig": {
                "InstanceType": "ml.g6.2xlarge",
                "InstanceCount": 1,
                "VolumeSizeInGB": 30
              },
              "StoppingCondition": {
                "MaxRuntimeInSeconds": 86400
              },
              "HyperParameters": {
                "cluster_id.$": "States.Format('{}', $.clusterId)",
                "training_run_id.$": "$.trainingRunId",
                "mapping_version.$": "$.mappingVersion",
                "source_mapping_revision.$": "$.sourceMappingRevision"
              },
              "Environment": {
                "LANDMARKS_TABLE": "LookSeeLandmarks",
                "DELETIONS_TABLE": "LookSeeLandmarkDeletions"
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "SageMaker.ThrottlingException",
                  "SageMaker.AmazonSageMakerException",
                  "ThrottlingException",
                  "States.TaskFailed"
                ],
                "IntervalSeconds": 10,
                "MaxAttempts": 6,
                "BackoffRate": 2
              }
            ],
            "ResultPath": "$.sagemakerResult",
            "Next": "PackageTrainingResult",
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.trainingFailure",
                "Next": "TrainingFailed"
              }
            ]
          },
          "PackageTrainingResult": {
            "Type": "Pass",
            "Parameters": {
              "clusterId.$": "$.clusterId",
              "trainingRunId.$": "$.trainingRunId",
              "datasetPrefix.$": "$.datasetPrefix",
              "classNames.$": "$.classNames",
              "imageCount.$": "$.imageCount",
              "positiveImageCount.$": "$.positiveImageCount",
              "globalNegativeCount.$": "$.globalNegativeCount",
              "hardNegativeCount.$": "$.hardNegativeCount",
              "totalImageCount.$": "$.totalImageCount",
              "TrainingJobName.$": "$.sagemakerResult.TrainingJobName",
              "TrainingJobStatus.$": "$.sagemakerResult.TrainingJobStatus",
              "ModelArtifacts.$": "$.sagemakerResult.ModelArtifacts",
              "mappingVersion.$": "$.mappingVersion",
              "sourceMappingRevision.$": "$.sourceMappingRevision"
            },
            "End": true
          },
          "TrainingFailed": {
            "Type": "Fail",
            "Error": "TrainingRunFailed",
            "Cause": "Training failed or eligibility changed. Inspect job logs and start a fresh packaging run; do not redrive this dataset."
          }
        }
      },
      "ResultPath": "$.trainingResults",
      "Next": "FinalizeTrainingRun"
    },
    "FinalizeTrainingRun": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:637404140724:function:LookSee-Finalizing-Training-run-negtest",
        "Payload": {
          "trainingRunId.$": "$.trainingRunId",
          "bucket.$": "$.bucket",
          "manifest.$": "$.manifestRead.Payload",
          "trainingResults.$": "$.trainingResults",
          "mappingVersion.$": "$.mappingSnapshot.mappingVersion",
          "sourceMappingRevision.$": "$.mappingSnapshot.sourceRevision",
          "mappingCount.$": "$.mappingSnapshot.mappingCount"
        }
      },
      "ResultPath": "$.finalizeResult",
      "End": true
    },
    "PackagerSucceeded": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.packagerResult.Containers[0].Name",
              "IsPresent": true
            },
            {
              "Variable": "$.packagerResult.Containers[0].Name",
              "StringEquals": "dataset-packager-HN"
            },
            {
              "Variable": "$.packagerResult.Containers[0].ExitCode",
              "IsPresent": true
            },
            {
              "Variable": "$.packagerResult.Containers[0].ExitCode",
              "NumericEquals": 0
            }
          ],
          "Next": "ReadManifest"
        }
      ],
      "Default": "PackagingFailed"
    },
    "PackagingFailed": {
      "Type": "Fail",
      "Error": "DatasetPackagingFailed",
      "Cause": "Packager did not report a successful exit. Inspect ECS logs and start a fresh execution."
    }
  }
}
