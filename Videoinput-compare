import cv2
import os
import boto3
import numpy as np
import urllib.parse  


s3_client = boto3.client("s3")


FRAME_SKIP = 3  
SIMILARITY_THRESHOLD = 0.80  
RESIZE_WIDTH = 640 
RESIZE_HEIGHT = 360  

TEMP_VIDEO_PATH = "/tmp/temp_video.mp4"
TEMP_FRAME_DIR = "/tmp/kept_frames"

orb = cv2.ORB_create(nfeatures=500)


# frame comparison 

def are_frames_similar(frame1, frame2):
    
    gray1 = cv2.cvtColor(frame1, cv2.COLOR_BGR2GRAY)
    gray2 = cv2.cvtColor(frame2, cv2.COLOR_BGR2GRAY)

    
    k1, d1 = orb.detectAndCompute(gray1, None)
    k2, d2 = orb.detectAndCompute(gray2, None)

   
    if d1 is None or d2 is None:
        return False

    # test frames wit each other
    bf = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=True)
    matches = bf.match(d1, d2)

    if len(matches) == 0:
        return False

    score = np.mean([m.distance for m in matches])
    normalized_score = 1 - (score / 100)

    return normalized_score >= SIMILARITY_THRESHOLD


# Video Processing
def process_video(input_bucket, video_key):

    #Clear temp frame folder
    if os.path.exists(TEMP_FRAME_DIR):
        for f in os.listdir(TEMP_FRAME_DIR):
            os.remove(os.path.join(TEMP_FRAME_DIR, f))
    else:
        os.makedirs(TEMP_FRAME_DIR)

    s3_client.download_file(input_bucket, video_key, TEMP_VIDEO_PATH)

    
    cap = cv2.VideoCapture(TEMP_VIDEO_PATH)

    previous_frame = None
    frame_index = 0
    kept_count = 0

    # Create folder name in output bucket
    base_name = video_key.replace("/", "_").rsplit(".", 1)[0]

    # loop through video frames
    while True:
        ret, frame = cap.read()
        if not ret:
            break

        #skip frames 
        if frame_index % FRAME_SKIP != 0:
            frame_index += 1
            continue

        # Resize frame
        resized = cv2.resize(frame, (RESIZE_WIDTH, RESIZE_HEIGHT))

        
        if previous_frame is None:
            save_and_upload(frame, base_name, frame_index)
            previous_frame = resized
            kept_count += 1
        else:
           
            if not are_frames_similar(previous_frame, resized):
                save_and_upload(frame, base_name, frame_index)
                previous_frame = resized
                kept_count += 1

        frame_index += 1

    cap.release()

    # Delete the temp video
    if os.path.exists(TEMP_VIDEO_PATH):
        os.remove(TEMP_VIDEO_PATH)

    return kept_count


#save frames and upload to s3 

def save_and_upload(frame, base_name, frame_index):

    # Save frame temporarily inside Lambda
    local_frame_path = f"{TEMP_FRAME_DIR}/frame_{frame_index}.jpg"
    cv2.imwrite(local_frame_path, frame)

    # Get output bucket name
    OUTPUT_BUCKET = os.environ["OUTPUT_BUCKET"]

    # Generate S3 path for uploaded frame
    s3_key = f"{base_name}/frame_{frame_index}.jpg"

    # Upload frame to S3
    s3_client.upload_file(local_frame_path, OUTPUT_BUCKET, s3_key)

    # Delete local frame after upload
    os.remove(local_frame_path)


#lambda
def lambda_handler(event, context):
    
    # Check if the event is from EventBridge or  S3
    if 'detail' in event:
        # EventBridge Format
        input_bucket = event['detail']['bucket']['name']
        video_key = urllib.parse.unquote_plus(event['detail']['object']['key'])
    elif 'Records' in event:
        # Direct S3 Format 
        input_bucket = event['Records'][0]['s3']['bucket']['name']
        video_key = urllib.parse.unquote_plus(event['Records'][0]['s3']['object']['key'])
    else:
        raise Exception("Unsupported event format")

    print(f"Triggered! Bucket: {input_bucket}, Key: {video_key}")
    
    kept_frames = process_video(input_bucket, video_key)

    return {
        "statusCode": 200,
        "body": f"Processed {video_key}. Kept {kept_frames} frames."
    }
